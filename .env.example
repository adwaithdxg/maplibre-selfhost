# =============================================================================
#  MapLibre Self-Hosted Infrastructure — Environment Configuration
# -----------------------------------------------------------------------------
#  Copy this file to ".env" and adjust the values for your deployment:
#
#      cp .env.example .env
#
#  Only DOMAIN and LETSENCRYPT_EMAIL are strictly required for a public,
#  HTTPS deployment. Everything else has production-sane defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PUBLIC ENDPOINT / TLS
# -----------------------------------------------------------------------------
# The fully-qualified domain name that points (DNS A/AAAA record) at this VPS.
# Example: maps.flowxperia.com
# Leave empty to run in IP-only / self-signed mode (no Let's Encrypt).
DOMAIN=

# Email used by Let's Encrypt for expiry notices and account recovery.
LETSENCRYPT_EMAIL=

# Master TLS switch.
#   false -> HTTP only on port 80. Access the map directly via the server IP:
#            http://<SERVER_IP>/   (this is the current default — no domain
#            needed). Switch to true once you point a DOMAIN at the box.
#   true  -> Nginx serves HTTPS on 443. If DOMAIN is set, certificates are
#            obtained automatically from Let's Encrypt; otherwise a self-signed
#            certificate is generated so the stack still boots.
ENABLE_SSL=false

# Use Let's Encrypt *staging* endpoint while testing to avoid rate limits.
# Set to 0 for real, trusted certificates in production.
LETSENCRYPT_STAGING=0

# Enable HTTP/3 (QUIC) listener on UDP/443. Requires the QUIC-enabled Nginx
# build (see docker/nginx/Dockerfile, BUILD_HTTP3=1). Safe to leave as-is;
# HTTP/2 is always enabled regardless.
ENABLE_HTTP3=false

# -----------------------------------------------------------------------------
# 2. MAP DATA / REGIONS
# -----------------------------------------------------------------------------
# Space-separated list of Geofabrik extract "keys" to download and merge into
# a single tileset. Each key maps to:
#   https://download.geofabrik.de/<key>-latest.osm.pbf
#
# Default focuses on the GCC states and adds a couple of neighbouring regions.
# Add or remove keys freely — the pipeline downloads, verifies, merges and
# (re)generates tiles automatically. Examples:
#   asia/gcc-states         -> Bahrain, Kuwait, Oman, Qatar, Saudi Arabia, UAE
#   asia/iraq  asia/jordan  asia/iran  asia/yemen  asia/india  africa/egypt
OSM_REGIONS="asia/gcc-states"

# Human-readable name for the merged dataset / tile source id used in the
# style and Martin (lowercase, no spaces).
TILESET_ID=basemap

# Force a fresh tile rebuild on the next `up` even if tiles already exist.
FORCE_TILE_REBUILD=false

# Minimum / maximum zoom for generated vector tiles. 0-14 is the OpenMapTiles
# standard; MapLibre overzooms beyond 14 client-side.
MIN_ZOOM=0
MAX_ZOOM=14

# -----------------------------------------------------------------------------
# 3. TILE GENERATION (Planetiler) RESOURCES
# -----------------------------------------------------------------------------
# Max JVM heap for Planetiler. Rule of thumb: ~1.5x the *merged* PBF size, but
# never exceed ~70% of the box RAM. On a 12 GB Contabo VPS, 6 GB is safe and
# leaves headroom for Martin + Nginx + the OS page cache.
PLANETILER_XMX=6g

# Storage strategy for Planetiler's node/relation caches:
#   ram  -> fastest, needs ~1.5x PBF RAM (fine for GCC-sized extracts)
#   mmap -> memory-mapped on disk, slower but tiny RAM (use for huge extracts)
PLANETILER_STORAGE=ram

# -----------------------------------------------------------------------------
# 4. TILE SERVER (Martin) RESOURCES
# -----------------------------------------------------------------------------
MARTIN_IMAGE=ghcr.io/maplibre/martin:latest
# In-process tile cache (MB). Larger = fewer disk reads under load.
MARTIN_CACHE_MB=512
# Worker threads. Match to spare CPU cores.
MARTIN_WORKERS=4

# -----------------------------------------------------------------------------
# 5. NGINX / EDGE CACHE
# -----------------------------------------------------------------------------
# Disk size cap for the tile proxy cache. 400 GB disk -> 20 GB is comfortable.
NGINX_TILE_CACHE_MAX=20g
# How long tiles are considered fresh in the edge cache.
NGINX_TILE_CACHE_TTL=30d
# Rate limit: requests/second/IP for the tile endpoints (burst handled below).
# Set generously — a map client fires many tile requests at once while panning.
# These values comfortably allow normal interactive use; raise further if you
# front many users behind one NAT IP. (To effectively disable, set a huge rate.)
NGINX_RATE_LIMIT=200r/s
NGINX_RATE_BURST=400

# -----------------------------------------------------------------------------
# 6. CONTAINER RESOURCE LIMITS (compose deploy.resources)
# -----------------------------------------------------------------------------
# Tune to your VPS. Values below target a 12 GB / 6 vCPU Contabo box.
GENERATOR_MEM_LIMIT=8g
MARTIN_MEM_LIMIT=2g
NGINX_MEM_LIMIT=1g

# -----------------------------------------------------------------------------
# 7. MISC
# -----------------------------------------------------------------------------
TZ=Asia/Dubai
# Compose project name (prefix for containers/volumes/networks).
COMPOSE_PROJECT_NAME=maplibre
