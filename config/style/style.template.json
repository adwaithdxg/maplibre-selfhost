{
  "version": 8,
  "name": "MapLibre Self-Hosted Basemap",
  "metadata": {
    "maptiler:copyright": "Built with Planetiler from OpenStreetMap data (ODbL).",
    "openmaptiles:version": "3.x"
  },
  "glyphs": "${PUBLIC_URL}/font/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["${PUBLIC_URL}/tiles/${TILESET_ID}/{z}/{x}/{y}"],
      "minzoom": ${MIN_ZOOM},
      "maxzoom": ${MAX_ZOOM},
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f8f4ef" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#d6e3c6", "fill-opacity": 0.6 }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "park", "meadow"]]],
      "paint": { "fill-color": "#e3ead7" }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "sand"],
      "paint": { "fill-color": "#f3ecd6" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "residential"],
      "paint": { "fill-color": "#ece8e3" }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#d9ead3", "fill-opacity": 0.7 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "intermittent"], 1],
      "paint": { "fill-color": "#a9cce3" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": { "line-color": "#a9cce3", "line-width": 1.2 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e4ddd2",
        "fill-outline-color": "#d4ccc0",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 15, 0.9]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "track"]]],
      "minzoom": 13,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 18, 6]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#fdf6e3",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 18, 12]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "primary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#fcefb4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.8, 18, 16]
      }
    },
    {
      "id": "road-trunk-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["trunk", "motorway"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f6b27b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 18, 20]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#9e9cab",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.6, 10, 2],
        "line-dasharray": [2, 1]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 4],
      "minzoom": 6,
      "paint": {
        "line-color": "#bdbcc6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 12, 1.4],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 15,
      "filter": ["<=", ["get", "rank"], 12],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": 11,
        "text-anchor": "top",
        "text-offset": [0, 0.6],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#5b5b56",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#67625a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#3d6c8c",
        "text-halo-color": "#dcebf5",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 10,
      "filter": ["in", ["get", "class"], ["literal", ["village", "suburb", "neighbourhood"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": 11,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#6b6660",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "filter": ["==", ["get", "class"], "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": 13,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4d4842",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold", "Noto Sans Arabic Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 12, 10, 18],
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#33302c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 8,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold", "Noto Sans Arabic Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 11, 6, 18],
        "text-transform": "uppercase",
        "text-max-width": 9,
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#5a554e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    }
  ]
}
