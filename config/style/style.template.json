{
  "version": 8,
  "name": "MapLibre Self-Hosted Basemap",
  "metadata": {
    "maptiler:copyright": "Built with Planetiler from OpenStreetMap data (ODbL)."
  },
  "glyphs": "${PUBLIC_URL}/font/{fontstack}/{range}.pbf",
  "sources": {
    "world": {
      "type": "vector",
      "tiles": ["${PUBLIC_URL}/tiles/world/{z}/{x}/{y}"],
      "minzoom": 0,
      "maxzoom": ${WORLD_MAX_ZOOM},
      "attribution": "© OpenStreetMap contributors, Natural Earth"
    },
    "openmaptiles": {
      "type": "vector",
      "tiles": ["${PUBLIC_URL}/tiles/${TILESET_ID}/{z}/{x}/{y}"],
      "minzoom": 0,
      "maxzoom": ${MAX_ZOOM},
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#eeeae1" }
    },

    {
      "id": "world-water",
      "type": "fill",
      "source": "world",
      "source-layer": "water",
      "metadata": { "mlb:tier": "world" },
      "paint": { "fill-color": "#9cc3dd" }
    },
    {
      "id": "world-landcover-ice",
      "type": "fill",
      "source": "world",
      "source-layer": "landcover",
      "metadata": { "mlb:tier": "world" },
      "filter": ["==", ["get", "class"], "ice"],
      "paint": { "fill-color": "#ffffff", "fill-opacity": 0.7 }
    },

    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 6,
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#cfe0bd", "fill-opacity": 0.55 }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 6,
      "filter": ["in", ["get", "class"], ["literal", ["grass", "park", "meadow"]]],
      "paint": { "fill-color": "#dde7cd" }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 6,
      "filter": ["==", ["get", "class"], "sand"],
      "paint": { "fill-color": "#efe6cf" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 8,
      "filter": ["==", ["get", "class"], "residential"],
      "paint": { "fill-color": "#e7e2d8" }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "minzoom": 7,
      "paint": { "fill-color": "#cfe6c4", "fill-opacity": 0.7 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "minzoom": 6,
      "filter": ["!=", ["get", "intermittent"], 1],
      "paint": { "fill-color": "#9cc3dd" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 9,
      "paint": { "line-color": "#9cc3dd", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.6, 16, 3] }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#dcd2c2",
        "fill-outline-color": "#c7baa6",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0.35, 16, 0.95]
      }
    },

    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "track"]]],
      "minzoom": 14,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#d6ccbd",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 2, 18, 9]
      }
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]],
      "minzoom": 11,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#cdbfa8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 1.6, 18, 16]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "primary"],
      "minzoom": 8,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#e0b264",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.6, 18, 20]
      }
    },
    {
      "id": "road-trunk-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["trunk", "motorway"]]],
      "minzoom": 5,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#e08a4f",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.6, 18, 24]
      }
    },

    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "track"]]],
      "minzoom": 14,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 1, 18, 6]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]],
      "minzoom": 11,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.8, 18, 12]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "primary"],
      "minzoom": 8,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#fbe2a4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 18, 15]
      }
    },
    {
      "id": "road-trunk-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["trunk", "motorway"]]],
      "minzoom": 5,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f6a96b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 18, 18]
      }
    },

    {
      "id": "world-boundary-country",
      "type": "line",
      "source": "world",
      "source-layer": "boundary",
      "metadata": { "mlb:tier": "world" },
      "filter": ["==", ["get", "admin_level"], 2],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#9b99a8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 1, 0.4, 6, 1.4],
        "line-dasharray": [2, 1]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 4],
      "minzoom": 6,
      "paint": {
        "line-color": "#b8b6c2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 12, 1.4],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "boundary-country-detail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "minzoom": 5,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#83818f",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 12, 2.4],
        "line-dasharray": [2, 1]
      }
    },

    {
      "id": "water-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 7,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#386789",
        "text-halo-color": "#dcebf5",
        "text-halo-width": 1
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#5d574e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 16,
      "filter": ["<=", ["get", "rank"], 10],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": 11,
        "text-anchor": "top",
        "text-offset": [0, 0.6],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#5b5b56",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 12,
      "filter": ["in", ["get", "class"], ["literal", ["village", "suburb", "neighbourhood"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": 11,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#6b6660",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": 13,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4d4842",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 7,
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold", "Noto Sans Arabic Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 12, 12, 18],
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#33302c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.8
      }
    },

    {
      "id": "world-place-city",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "metadata": { "mlb:tier": "world" },
      "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]],
      "maxzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular", "Noto Sans Arabic Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 10, 7, 14],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4d4842",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "world-place-country",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "metadata": { "mlb:tier": "world" },
      "filter": ["==", ["get", "class"], "country"],
      "maxzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold", "Noto Sans Arabic Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 10, 6, 16],
        "text-transform": "uppercase",
        "text-max-width": 9,
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#5a554e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    }
  ]
}
